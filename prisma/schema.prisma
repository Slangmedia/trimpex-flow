generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(uuid())
  name               String
  email              String            @unique
  password_hash      String
  role               Role              @default(EMPLOYEE)
  avatar_url         String?
  createdAt          DateTime          @default(now())
  createdClients     Client[]          @relation("AdminCreatedClients")
  notifications      Notification[]
  createdProjects    Project[]         @relation("AdminCreatedProjects")
  assignedProjects   ProjectEmployee[]
  createdRenderItems RenderItem[]      @relation("EmployeeCreatedRenderItems")
  submittedRenders   RenderVersion[]   @relation("EmployeeSubmittedVersions")
}

model Client {
  id                String    @id @default(uuid())
  name              String
  contact_person    String
  email             String    @unique
  phone             String?
  logo_url          String?
  public_link_token String    @unique @default(uuid())
  pin_enabled       Boolean   @default(false)
  pin_hash          String?
  is_active         Boolean   @default(true)
  createdAt         DateTime  @default(now())
  created_by_id     String
  createdBy         User      @relation("AdminCreatedClients", fields: [created_by_id], references: [id])
  projects          Project[]

  @@index([created_by_id], map: "Client_created_by_id_fkey")
}

model Project {
  id                 String            @id @default(uuid())
  name               String
  description        String?
  total_render_count Int
  deadline           DateTime
  is_active          Boolean           @default(true)
  createdAt          DateTime          @default(now())
  client_id          String
  created_by_id      String
  notifications      Notification[]
  client             Client            @relation(fields: [client_id], references: [id])
  createdBy          User              @relation("AdminCreatedProjects", fields: [created_by_id], references: [id])
  employees          ProjectEmployee[]
  renderItems        RenderItem[]

  @@index([client_id], map: "Project_client_id_fkey")
  @@index([created_by_id], map: "Project_created_by_id_fkey")
}

model ProjectEmployee {
  id          String   @id @default(uuid())
  project_id  String
  employee_id String
  assigned_at DateTime @default(now())
  employee    User     @relation(fields: [employee_id], references: [id])
  project     Project  @relation(fields: [project_id], references: [id])

  @@unique([project_id, employee_id])
  @@index([employee_id], map: "ProjectEmployee_employee_id_fkey")
}

model RenderItem {
  id              String          @id @default(uuid())
  name            String
  sku_code        String
  current_version Int             @default(1)
  current_status  RenderStatus    @default(SUBMITTED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  project_id      String
  created_by_id   String
  notifications   Notification[]
  createdBy       User            @relation("EmployeeCreatedRenderItems", fields: [created_by_id], references: [id])
  project         Project         @relation(fields: [project_id], references: [id])
  versions        RenderVersion[]

  @@index([created_by_id], map: "RenderItem_created_by_id_fkey")
  @@index([project_id], map: "RenderItem_project_id_fkey")
}

model RenderVersion {
  id                 String        @id @default(uuid())
  version_number     Int
  file_url           String
  file_type          FileType
  submitted_at       DateTime      @default(now())
  admin_reviewed_at  DateTime?
  admin_action       AdminAction?
  admin_note         String?
  client_reviewed_at DateTime?
  client_action      ClientAction?
  client_feedback    String?
  is_current_version Boolean       @default(true)
  render_item_id     String
  submitted_by_id    String
  renderItem         RenderItem    @relation(fields: [render_item_id], references: [id])
  submittedBy        User          @relation("EmployeeSubmittedVersions", fields: [submitted_by_id], references: [id])

  @@index([render_item_id], map: "RenderVersion_render_item_id_fkey")
  @@index([submitted_by_id], map: "RenderVersion_submitted_by_id_fkey")
}

model Notification {
  id                 String           @id @default(uuid())
  type               NotificationType
  message            String
  is_read            Boolean          @default(false)
  createdAt          DateTime         @default(now())
  user_id            String?
  client_token       String?
  related_render_id  String?
  related_project_id String?
  relatedProject     Project?         @relation(fields: [related_project_id], references: [id])
  relatedRender      RenderItem?      @relation(fields: [related_render_id], references: [id])
  user               User?            @relation(fields: [user_id], references: [id])

  @@index([related_project_id], map: "Notification_related_project_id_fkey")
  @@index([related_render_id], map: "Notification_related_render_id_fkey")
  @@index([user_id], map: "Notification_user_id_fkey")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum RenderStatus {
  SUBMITTED
  CLIENT_PENDING
  COMPLETE
  REJECTED
  REVISION_REQUIRED
  ADMIN_REJECTED
}

enum FileType {
  IMAGE
  VIDEO
}

enum AdminAction {
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

enum ClientAction {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum NotificationType {
  PROJECT_ASSIGNED
  RENDER_SUBMITTED
  ADMIN_APPROVED
  ADMIN_REJECTED
  CLIENT_APPROVED
  CLIENT_REJECTED
  CLIENT_REQUESTED_CHANGES
}
